[profiles._base]
overwrite = {{ overwrite | lower }}
log_level = {{ log_level | tojson }}
graph_write_strategy = {{ graph_write_strategy | tojson }}
materialization_backend = "worph"
canonical_id_strategy = {{ canonical_id_strategy | tojson }}
concurrency = {{ concurrency }}
postprocessor_pool_size = {{ postprocessor_pool_size }}
postprocessor_runtime = {{ postprocessor_runtime | tojson }}
shacl_pool_size = {{ shacl_pool_size }}
shacl_exclude_builtin_shapes = {{ shacl_exclude_builtin_shapes | tojson }}
mapping_pool_size = {{ mapping_pool_size }}
ingest_loader = {{ ingest_loader | tojson }}
{% if ingest_loader == "playwright" %}
playwright_wait_until = {{ playwright_wait_until | tojson }}
playwright_headless = {{ playwright_headless | lower }}
{% elif ingest_loader == "crawler" %}
crawler_js_render_mode = {{ crawler_js_render_mode | tojson }} # disabled | auto | enabled
crawler_proxy_mode = {{ crawler_proxy_mode | tojson }}         # disabled | simple | standard | premium | auto
{% endif %}
{% if ingest_loader == "crawler" %}
# ingest_timeout_ms = {{ ingest_timeout_ms }}
{% else %}
# ingest_timeout_ms = 30000
{% endif %}
ingest_retry_attempts = {{ ingest_retry_attempts }}
ingest_retry_backoff_ms = {{ ingest_retry_backoff_ms }}
google_search_console = {{ google_search_console | lower }}
{% if source_type == "urls" %}
ingest_source = "urls"
urls = {{ urls | tojson }}
{% elif source_type == "sitemap" %}
ingest_source = "sitemap"
sitemap_url = {{ sitemap_url | tojson }}
{% if sitemap_url_pattern %}sitemap_url_pattern = {{ sitemap_url_pattern | tojson }}
{% endif %}
{% elif source_type == "google_sheets" %}
ingest_source = "sheets"
sheets_url = {{ sheets_url | tojson }}
sheets_name = {{ sheets_name | tojson }}
sheets_service_account = "${SHEETS_SERVICE_ACCOUNT}"
{% endif %}

{% for profile in profiles %}
[profiles.{{ profile }}]
api_key = "${WORDLIFT_API_KEY}"
{% endfor %}
